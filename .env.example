# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# Server Port
PORT=3000

# Authentication & JWT Secret (32+ character high-entropy key)
JWT_SECRET="replace-with-a-long-random-secret"
JWT_EXPIRES_IN="7d"

# Used only when the database has no active administrator; never reuse these credentials.
INITIAL_ADMIN_USERNAME="owner"
INITIAL_ADMIN_EMAIL="owner@example.com"
INITIAL_ADMIN_PASSWORD="replace-with-a-private-password-at-least-12-characters"
INITIAL_ADMIN_FULL_NAME="Store Administrator"

# MongoDB Database Connection String
# e.g., mongodb://localhost:27017/retail_inventory or MongoDB Atlas URI
# If empty or not reachable, the system uses an embedded atomic datastore
MONGODB_URI="mongodb://localhost:27017/retail_inventory"

# Store & Fiscal Defaults
DEFAULT_CURRENCY="INR"
DEFAULT_TAX_RATE_PERCENT="18"
DEFAULT_DISCOUNT_PERCENT="0"
STORE_NAME="Apex Retail Mart"
STORE_ADDRESS="Plot 42, Commercial Avenue, Sector 5"
STORE_GSTIN="07AAAAA0000A1Z5"

# Cloudinary Integration (Product Image Uploads)
# Obtain these from your Cloudinary Management Console -> Dashboard -> Product Environment Credentials
CLOUDINARY_CLOUD_NAME="your_cloudinary_cloud_name"
CLOUDINARY_API_KEY="your_cloudinary_api_key"
CLOUDINARY_API_SECRET="your_cloudinary_api_secret"
CLOUDINARY_FOLDER="retailflow/products"
MAX_IMAGE_SIZE_MB="5"
